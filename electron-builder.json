{
  "appId": "com.gsus.activitystatus",
  "productName": "Activity Status Companion",
  "asarUnpack": [
    "backend/**/*"
  ],
  "directories": {
    "output": "companion-dist"
  },
  "files": [
    "companion/**/*",
    "extension/icons/**/*",
    "build/icon.png",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "backend",
      "to": "backend",
      "filter": [
        "**/*",
        "!node_modules/.cache/**/*",
        "!.env",
        "!Dockerfile",
        "!Procfile",
        "!docker-compose.yml",
        "!fly.toml",
        "!runtime.txt",
        "!generate_icons.py"
      ]
    }
  ],
  "extraMetadata": {
    "main": "companion/main.cjs"
  },
  "afterPack": "scripts/ad-hoc-sign-mac.cjs",
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.utilities",
    "artifactName": "${productName}-${arch}.${ext}",
    "icon": "build/icon.png"
  },
  "win": {
    "target": ["nsis", "zip"],
    "artifactName": "${productName}-Setup-${arch}.${ext}",
    "icon": "build/icon.png"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility",
    "artifactName": "${productName}-${arch}.${ext}",
    "maintainer": "GSUS2K <ganesh21112000@gmail.com>",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
