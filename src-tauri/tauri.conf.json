{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Status Companion",
  "version": "1.0.49",
  "identifier": "com.gsus.activitystatus",
  "build": {
    "frontendDist": "../tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Discord Status Companion",
        "url": "index.html",
        "width": 420,
        "height": 560,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Discord Status Companion Settings",
        "url": "settings.html",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "selector",
        "title": "Select Discord Status",
        "url": "selector.html",
        "width": 720,
        "height": 560,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright © 2026 GSUS2K",
    "shortDescription": "Discord Status companion",
    "longDescription": "Small local companion app for Discord Status browser Rich Presence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}


